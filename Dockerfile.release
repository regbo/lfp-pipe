FROM rust:1.93-bookworm AS build
ARG RELEASE_TAG
WORKDIR /src
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libayatana-appindicator3-dev \
        libgtk-3-dev \
        libxdo-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY client.multi.example.toml client.authorization.example.toml ./
COPY shared ./shared
COPY server ./server
COPY client ./client
RUN cargo test --workspace --release --locked --target x86_64-unknown-linux-gnu \
    && cargo build --workspace --release --locked --target x86_64-unknown-linux-gnu
RUN archive="lfp-pipe-${RELEASE_TAG}-x86_64-unknown-linux-gnu" \
    && mkdir -p "/out/${archive}/bin" \
    && cp target/x86_64-unknown-linux-gnu/release/lfp-pipe-server "/out/${archive}/bin/" \
    && cp target/x86_64-unknown-linux-gnu/release/lfp-pipe-client "/out/${archive}/bin/" \
    && tar -C /out -czf "/out/${archive}.tar.gz" "${archive}" \
    && rm -rf "/out/${archive}"

FROM scratch AS export
COPY --from=build /out/ /
