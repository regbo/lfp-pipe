LFP_AUTH_PUBLIC_URL=https://connect.example.com
LFP_ROUTE_SUFFIX=subdomain.domain
AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/lfp-connect/
AUTHENTIK_CLIENT_ID=replace-me
NATS_AUTH_ISSUER_PUBLIC_KEY=A_REPLACE_ME
NATS_AUTH_XKEY_PUBLIC_KEY=X_REPLACE_ME
LFP_NODE_DOMAIN=example.com
LFP_PUBLIC_NATS_URLS=tls://nats-pipe.example.com:443

# Images must be available to every Swarm node through a registry or pre-load.
LFP_AUTH_IMAGE=registry.example.com/lfp-connect-auth:latest
LFP_WEB_IMAGE=registry.example.com/lfp-connect-web:latest
LFP_SERVER_IMAGE=registry.example.com/lfp-pipe-server:latest
