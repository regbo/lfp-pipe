FROM rust:1.93-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY shared ./shared
COPY server ./server
COPY client ./client
RUN cargo build --locked --release -p client --no-default-features

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 lfp
COPY --from=build /src/target/release/lfp-pipe-client /usr/local/bin/lfp-pipe-client
USER lfp
ENTRYPOINT ["/usr/local/bin/lfp-pipe-client"]
CMD ["--tray", "never"]
